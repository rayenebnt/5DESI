{
  "name": "medx-design-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Scripts de construction qui génèrent les diagrammes MedX, le dossier de conception (HTML/PDF) et la présentation (PPTX).",
  "scripts": {
    "check": "node check-docs.js",
    "diagrams": "node render-diagrams.js",
    "report": "node build-report.js",
    "slides": "node build-slides.js",
    "all": "npm run diagrams && npm run check && npm run report && npm run slides"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "playwright-core": "^1.56.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20"
  }
}
